# The witness server. Plain sh, no build tool, nothing fetched at run time: this process is meant
# to be installed once and left alone for years, and every moving part is one more reason it might
# one day fail to come back up.
set -eu

home=$(cd "$(dirname "$0")/.." && pwd)

: "${JAVA_HOME:=}"
if [ -n "$JAVA_HOME" ]; then
    java="$JAVA_HOME/bin/java"
else
    java=java
fi

# Small and fixed. A witness holds a few hundred bytes per served cluster and answers a handful of
# datagrams a second; what matters is that it never pauses, not that it can grow.
: "${PRIMOS_WITNESS_OPTS:=-Xms64m -Xmx128m -XX:+ExitOnOutOfMemoryError}"

# Without --config the witness runs from this directory: conf/ beside bin/, and the state in data/
# as the sample's state.directory says. Neither ships in the tarball, so an upgrade unpacked over
# this directory cannot replace the keys or forget a vote.
case " $* " in
    *" --config "* | *" --config="* | *" -V "* | *" --version "* | *" -h "* | *" --help "*) ;;
    *)
        if [ ! -d "$home/conf" ]; then
            echo "no configuration in $home/conf: copy $home/conf-sample to it and edit it, or pass --config <directory>" >&2
            exit 2
        fi
        set -- --config "$home/conf" "$@"
        ;;
esac

exec "$java" $PRIMOS_WITNESS_OPTS \
    -cp "$home/lib/*" \
    org.lolaf.primos.witness.cli.WitnessMain "$@"
