<assembly xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>dist</id>

    <formats>
        <format>tar.gz</format>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>

    <dependencySets>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <scope>runtime</scope>
        </dependencySet>
    </dependencySets>

    <fileSets>
        <fileSet>
            <directory>src/main/dist/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>
        <!--
          The sample configuration, not a working one. It is deliberately not installed over
          anything: an upgrade that quietly replaced witness.properties would replace the secrets
          with placeholders, and a witness whose secret changed under it stops being able to
          answer the clusters that depend on it.
        -->
        <fileSet>
            <directory>src/main/dist/conf</directory>
            <outputDirectory>conf-sample</outputDirectory>
            <fileMode>0640</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/..</directory>
            <outputDirectory></outputDirectory>
            <includes>
                <include>LICENSE.txt</include>
            </includes>
        </fileSet>
        <!-- The operator manual travels with the thing it documents, so it is to hand on a box
             that may have no browser and no route to a wiki.

             It lives in primos-witness rather than here, because almost all of it documents server
             behaviour that every packaging shares — the safety rules, the keyring, config.source,
             hot reload. Copying it into each front door is how two manuals drift apart. -->
        <fileSet>
            <directory>${project.basedir}/../primos-witness</directory>
            <outputDirectory></outputDirectory>
            <includes>
                <include>README.md</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
