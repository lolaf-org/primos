<assembly xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>dist</id>

    <formats>
        <format>tar.gz</format>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>

    <dependencySets>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <scope>runtime</scope>
        </dependencySet>
    </dependencySets>

    <fileSets>
        <fileSet>
            <directory>src/main/dist/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>
        <!--
          The sample configuration, not a working one. It is deliberately not installed over
          anything: an upgrade that quietly replaced witness.properties would replace the secrets
          with placeholders, and a witness whose secret changed under it stops being able to
          answer the clusters that depend on it.
        -->
        <fileSet>
            <directory>src/main/dist/conf</directory>
            <outputDirectory>conf-sample</outputDirectory>
            <fileMode>0640</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/..</directory>
            <outputDirectory></outputDirectory>
            <includes>
                <include>LICENSE.txt</include>
            </includes>
        </fileSet>
    </fileSets>

    <!--
        Two documents, because they answer different questions and neither is complete alone. This
        module's README is what somebody who just unpacked this tarball wants — where to put it, the
        options, the systemd unit. The manual is everything about the server that is true whichever
        front door runs it: the safety rules, the keyring, config.source, hot reload, what to alert
        on.

        The manual lives in primos-witness rather than here, because copying it into each front door
        is how two manuals drift apart. Both travel with the thing they document, so they are to
        hand on a box with no browser and no route to a wiki. destName is why these are <file>
        entries rather than a fileSet: a fileSet cannot rename, and two files called README.md
        cannot share a directory.
    -->
    <files>
        <file>
            <source>${project.basedir}/README.md</source>
            <outputDirectory></outputDirectory>
            <destName>README.md</destName>
        </file>
        <file>
            <source>${project.basedir}/../primos-witness/README.md</source>
            <outputDirectory></outputDirectory>
            <destName>MANUAL.md</destName>
        </file>
    </files>
</assembly>
