<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.lolaf.primos</groupId>
    <artifactId>primos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Primos</name>
    <description>
        Raft leader election for clustered Java applications: every instance knows whether it is the
        leader or a follower, and is told the moment that changes. Optional witness for two-node clusters.
    </description>
    <url>https://github.com/lolaf-org/primos</url>
    <inceptionYear>2026</inceptionYear>
    <organization>
        <name>Lolaf</name>
        <url>https://www.lolaf.org</url>
    </organization>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>cmunger</id>
            <name>Cedric Munger</name>
            <url>https://github.com/cmunger</url>
            <organization>Lolaf.org</organization>
            <organizationUrl>https://www.lolaf.org</organizationUrl>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Reproducible builds -->
        <project.build.outputTimestamp>2026-08-28T00:00:00Z</project.build.outputTimestamp>
        <!-- release, not source/target: it compiles against the real Java 11 API, so building on a
             newer JDK cannot silently use a method that fails at runtime on 11. -->
        <maven.compiler.release>11</maven.compiler.release>

        <slf4j.version>2.0.17</slf4j.version>
        <lombok.version>1.18.48</lombok.version>
        <junit.version>5.14.4</junit.version>
        <mockito.version>5.24.0</mockito.version>
        <assertj-core.version>3.27.7</assertj-core.version>
        <awaitility.version>4.3.0</awaitility.version>
        <picocli.version>4.7.7</picocli.version>
        <micrometer.version>1.17.2</micrometer.version>
        <spring-boot.version>4.1.1</spring-boot.version>

        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-assembly-plugin.version>3.8.0</maven-assembly-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
        <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
        <!-- Appended to what maven-release-plugin passes to its forked builds -->
        <release.extraArguments/>
        <lombok-maven-plugin.version>1.18.20.0</lombok-maven-plugin.version>
        <license-maven-plugin.version>5.1.2</license-maven-plugin.version>

        <!-- Mockito 5 needs to be loaded as an agent rather than self-attaching, which newer JDKs
             warn about today and will refuse outright. -->
        <surefire.argLine>
            -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
            -Xshare:off
            ${surefire.argLine.extra}
        </surefire.argLine>
        <surefire.argLine.extra/>

        <automatic.module.name>org.lolaf.primos.MODULE.NAME.NOT.SET</automatic.module.name>
        <license.source.dir>${project.basedir}/..</license.source.dir>
        <delombok.skip>false</delombok.skip>
        <javadoc.delomboked.sources>${project.build.directory}/delombok</javadoc.delomboked.sources>
        <javadoc.sourcepath>${javadoc.delomboked.sources}</javadoc.sourcepath>
    </properties>

    <modules>
        <module>primos</module>
        <module>primos-witness</module>
        <module>primos-micrometer</module>
        <module>primos-witness-cli</module>
        <module>primos-witness-boot</module>
        <module>primos-spring-boot-starter</module>
    </modules>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/lolaf-org/primos.git</connection>
        <developerConnection>scm:git:https://github.com/lolaf-org/primos.git</developerConnection>
        <url>https://github.com/lolaf-org/primos</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/lolaf-org/primos/issues</url>
    </issueManagement>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <!-- The witness server's command line, and the only dependency in the estate outside
                 SLF4J. It reaches primos-witness alone: the library stays SLF4J-only, because that
                 rule is about what a consumer inherits and nobody depends on the server. -->
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <!-- Reaches primos-micrometer alone, which exists so that an application wanting no
                 Micrometer receives none. Java 8 bytecode, so the Java 11 target holds. -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-core</artifactId>
                <version>${micrometer.version}</version>
            </dependency>
            <!-- Align every transitive org.junit.* artifact to a single JUnit version. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Compile-time only: an annotation processor that generates plain Java. provided scope is
             not transitive, so nothing reaches anyone who depends on primos. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>${awaitility.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <!-- Lombok on the processor path rather than the classpath, so it stays out
                             of the module's own compile classpath entirely. -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>default-jar</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                            <configuration>
                                <archive>
                                    <manifest>
                                        <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                                        <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                                    </manifest>
                                    <manifestEntries>
                                        <Built-By>Lolaf</Built-By>
                                        <Implementation-URL>https://github.com/lolaf-org/primos</Implementation-URL>
                                        <Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name>
                                    </manifestEntries>
                                </archive>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${maven-assembly-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.projectlombok</groupId>
                    <artifactId>lombok-maven-plugin</artifactId>
                    <version>${lombok-maven-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <skip>${delombok.skip}</skip>
                        <addOutputDirectory>false</addOutputDirectory>
                        <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
                        <outputDirectory>${javadoc.delomboked.sources}</outputDirectory>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <configuration>
                        <doclint>all,-missing</doclint>
                        <failOnError>true</failOnError>
                        <detectJavaApiLink>false</detectJavaApiLink>
                        <detectOfflineLinks>false</detectOfflineLinks>
                        <quiet>true</quiet>
                        <!-- Javadoc reads the delomboked sources, so generated accessors and
                             builders are documented rather than missing. -->
                        <sourcepath>${javadoc.sourcepath}</sourcepath>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <argLine>${surefire.argLine}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>${maven-release-plugin.version}</version>
                    <configuration>
                        <tagNameFormat>v@{project.version}</tagNameFormat>
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                        <releaseProfiles>release</releaseProfiles>
                        <!-- release:perform otherwise sets performRelease=true, which activates
                             release-profile from Maven's super-POM, and that profile attaches a
                             sources jar and a javadoc jar of its own under different execution ids.
                             Both would fire: two -sources.jar and two -javadoc.jar per module. -->
                        <useReleaseProfile>false</useReleaseProfile>
                        <arguments>-T1C ${release.extraArguments}</arguments>
                        <scmReleaseCommitComment>release @{releaseLabel}</scmReleaseCommitComment>
                        <scmDevelopmentCommitComment>resume development after @{releaseLabel}</scmDevelopmentCommitComment>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>delombok-for-javadoc</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>delombok</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <inherited>false</inherited>
                <configuration>
                    <!-- The check runs from the aggregator alone (inherited=false), which by
                         default excludes every module directory and so checks nothing at all.
                         aggregate=true is what makes the parent walk the modules too. -->
                    <aggregate>true</aggregate>
                    <licenseSets>
                        <licenseSet>
                            <header>${project.basedir}/HEADER.txt</header>
                            <!-- HEADER.txt is a template; without these the placeholders would
                                 never match a real file. -->
                            <properties>
                                <year>2026</year>
                                <owner>Lolaf.org</owner>
                            </properties>
                            <excludes>
                                <exclude>**/LICENSE.txt</exclude>
                                <exclude>**/*.txt</exclude>
                                <exclude>**/*.md</exclude>
                                <exclude>**/*.yaml</exclude>
                                <exclude>**/*.yml</exclude>
                                <exclude>**/*.sh</exclude>
                                <exclude>**/mvnw</exclude>
                                <exclude>**/.mvn/**</exclude>
                                <exclude>**/pom.xml</exclude>
                                <exclude>**/lombok.config</exclude>
                                <exclude>**/src/main/resources/**</exclude>
                                <exclude>**/src/test/resources/**</exclude>
                                <!-- Shipped sample config an operator copies and edits; the same
                                     reasoning as the resources above. -->
                                <exclude>**/src/main/dist/conf/**</exclude>
                                <exclude>**/src/main/docker/conf/**</exclude>
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                    <!-- Neither the launcher nor the Dockerfile has an extension, so nothing
                         maps them to a comment style and both would be reported as Unknown rather
                         than checked. Mapped rather than excluded: they are shipped source like
                         any other file here. -->
                    <mapping>
                        <primos-witness>SCRIPT_STYLE</primos-witness>
                        <Dockerfile>SCRIPT_STYLE</Dockerfile>
                        <dockerignore>SCRIPT_STYLE</dockerignore>
                    </mapping>
                </configuration>
                <executions>
                    <execution>
                        <id>check-license-headers</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>source-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-license-into-the-jar</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${license.source.dir}</directory>
                                    <includes>
                                        <include>LICENSE.txt</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.6.3,)</version>
                                    <message>Maven 3.6.3 or newer is required: older versions ignore the child.*.inherit.append.path attributes the published poms rely on.</message>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                    <message>Building primos needs JDK 17 or newer, for the two Spring Boot modules. The libraries still run on Java 11.</message>
                                </requireJavaVersion>
                                <requireReleaseDeps>
                                    <onlyWhenRelease>true</onlyWhenRelease>
                                    <message>A release may not depend on a SNAPSHOT: Central rejects the bundle, and the artifact would be unbuildable once that snapshot moved.</message>
                                </requireReleaseDeps>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- keyname comes from the CI secret -->
                            <bestPractices>true</bestPractices>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <!-- The <server> id in settings.xml holding the Portal token. -->
                            <publishingServerId>central</publishingServerId>
                            <checksums>required</checksums>
                            <!-- Upload and validate, do not publish automatically -->
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <!-- central-publishing ignores maven.deploy.skip: a module missing here is published -->
                            <excludeArtifacts>
                                <excludeArtifact>primos-witness-cli</excludeArtifact>
                                <excludeArtifact>primos-witness-boot</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
