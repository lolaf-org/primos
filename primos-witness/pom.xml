<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.primos</groupId>
        <artifactId>primos-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>primos-witness</artifactId>

    <name>Primos Witness Server</name>
    <description>
        The standalone witness server: a leader-ineligible voter, deployed in a third failure domain,
        that lets a two-node active/passive pair survive a partition without split brain. One instance
        serves many clusters at once, keyed by application name.
    </description>

    <properties>
        <automatic.module.name>org.lolaf.primos.witness</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.primos</groupId>
            <artifactId>primos</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- This one is an application, not a library, so it ships its own logging backend at
             runtime. The SLF4J-only rule constrains what consumers inherit; nobody depends on this. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.lolaf.primos</groupId>
            <artifactId>primos</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                The operator-facing artifact. The library is a jar people depend on; this module is
                a process people install, and nobody embedding primos should ever receive it.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/distribution.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>true</appendAssemblyId>
                            <tarLongFileMode>posix</tarLongFileMode>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
