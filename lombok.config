# Root of the Lombok config tree: nothing above this directory is consulted.
config.stopBubbling = true

# Marks generated methods with @lombok.Generated so coverage tools skip them.
lombok.addLombokGeneratedAnnotation = true

# Record-style accessors everywhere: peer.id(), not peer.getId(). Java 11 has no records, which
# is the whole reason Lombok is here; the accessors should still read like it does.
lombok.accessors.fluent = true
